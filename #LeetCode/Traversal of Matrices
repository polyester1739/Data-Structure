                    diagonals[i][p++] = mat[row++][column++];
                    diagonalSizes[i]++;
                }
    
                // 为每一条对角线的元素重新排序
                qsort(diagonals[i].data(), diagonalSizes[i], sizeof(int), cmp);
            }
    
            for (int i = 0; i < mat.size() + mat[0].size() - 1; i++) {
                if (i < mat.size()) {
                    row = mat.size() - 1 - i;
                    column = 0;
                }
