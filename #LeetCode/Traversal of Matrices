            // 使用一个二维数组来存储对角线的数据
            vector<vector<int>> diagonals(mat.size() + mat[0].size() - 1);
            int diagonalMaxSize = (mat.size() < mat[0].size()) ? mat.size() : mat[0].size();
            for (int i = 0; i < mat.size() + mat[0].size() - 1; i++) diagonals[i].resize(diagonalMaxSize);
            vector<int> diagonalSizes(mat.size() + mat[0].size() - 1);
    
            // 向右下方遍历
            int row, column;
