Solution:
  C:
    /**
     * Note: The returned array must be malloced, assume caller calls free().
     */
    int* spiralOrder(int** matrix, int matrixSize, int* matrixColSize, int* returnSize) {
        // 设置四个方向上的边界
        int upper = 0;
        int lower = matrixSize - 1;
        int left = 0;
        int right = matrixColSize[0] - 1;
    
        // 设置返回数组
        int* ret = (int*)malloc(sizeof(int) * matrixSize * matrixColSize[0]);
        int p = 0;
    
        // 按照右下左上的顺序来逐步遍历
        while (upper < lower && left < right) {
            for (int i = left; i <= right; i++) ret[p++] = matrix[upper][i];
            upper++;
            for (int i = upper; i <= lower; i++) ret[p++] = matrix[i][right];
            right--;
            for (int i = right; i >= left; i--) ret[p++] = matrix[lower][i];
            lower--;
            for (int i = lower; i >= upper; i--) ret[p++] = matrix[i][left];
            left++;
        }
    
        // 处理行数/列数为奇数的情况
        if (upper == lower && left != right)
            for (int i = left; i <= right; i++) ret[p++] = matrix[upper][i];
        else if (upper != lower && left == right)
            for (int i = upper; i <= lower; i++) ret[p++] = matrix[i][left];
        else if (upper == lower && left == right) ret[p++] = matrix[upper][left];
    
        *returnSize = p;
        return ret;
    }

