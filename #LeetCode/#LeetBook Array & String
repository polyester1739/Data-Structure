7. 最长公共前缀    (14)

编写一个函数来查找字符串数组中的最长公共前缀。

如果不存在公共前缀，返回空字符串 ""。
 

示例 1：
  输入：strs = ["flower","flow","flight"]
  输出："fl"

示例 2：
  输入：strs = ["dog","racecar","car"]
  输出：""
  解释：输入不存在公共前缀。

提示：
  1 <= strs.length <= 200
  0 <= strs[i].length <= 200
  strs[i] 如果非空，则仅由小写英文字母组成

Solution:
  C:
    char* longestCommonPrefix(char** strs, int strsSize) {
        // 如果字符串数组里面没有元素，返回空串
        if (strs == NULL || strsSize == 0) {
            char* ret = (char*)malloc(sizeof(char));
            ret[0] = '\0';
            return ret;
        }
    
        // 如果所有在同一索引处的字符一致，记录该字符并后移索引
        char* ret = (char*)malloc(sizeof(char) * 201);
        int charIndex = 0;
        bool consistent = true;
        char element;
    
        while (consistent) {
            if (strs[0][charIndex] == '\0') {
                consistent = false;
                break;
            }
            element = strs[0][charIndex];
    
            for (int strIndex = 1; strIndex < strsSize; strIndex++) {
                if (strs[strIndex][charIndex] == '\0' || strs[strIndex][charIndex] != element) {
                    consistent = false;
                    break;
                }
            }
    
            if (consistent) ret[charIndex++] = element;
        }
    
        ret[charIndex] = '\0';
        return ret;
    }

  C++:
