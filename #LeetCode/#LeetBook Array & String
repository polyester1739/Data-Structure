    int min(int a, int b) {
        return a < b ? a : b;
    }
    
    int expand(const char* s, int left, int right) {
        while (left >= 0 && right < strlen(s) && s[left] == s[right]) {
            left--;
            right++;
        }
        return (right - left - 2) / 2;
    }
    
    char* longestPalindrome(char* s) {
        // 字符串预处理
        char* adapted = (char*)malloc(sizeof(char) * (2 * strlen(s) + 2));
        int p = 0;
        for (int i = 0; i < (2 * strlen(s) + 1); i++) {
            if (i % 2 == 0) adapted[i] = '#';
            else adapted[i] = s[p++];
        }
        adapted[2 * strlen(s) + 1] = '\0';
    
        // 创建变量以及参数表
        int start = 0, end = -1, right = -1, center = -1;
        int* radiuses = (int*)malloc(sizeof(int) * (2 * strlen(s) + 1));
    
        for (int i = 0; i < (2 * strlen(s) + 1); i++) {
            // 如果位于最右侧之内
            if (i <= right) {
                int sym = 2 * center - i;
                int minRadius = min(right - i, radiuses[sym]);
                radiuses[i] = expand(adapted, i - minRadius, i + minRadius);
            }
            // 如果位于最右侧之外
            else radiuses[i] = expand(adapted, i, i);
    
            // 更新最右侧
            if (i + radiuses[i] > right) {
                center = i;
                right = i + radiuses[i];
            }
    
            // 更新起止位置
            if (2 * radiuses[i] + 1 > end - start) {
                end = i + radiuses[i];
                start = i - radiuses[i];
            }
        }
    
        // 返回最长子串
        char* ret = (char*)malloc(sizeof(char) * (end - start + 1));
        p = 0;
        for (int i = start; i <= end; i++) {
            if (adapted[i] == '#') continue;
            else ret[p++] = adapted[i];
        }
        ret[p] = '\0';
    
        free(adapted);
        free(radiuses);
    
        return ret;
    }

