            if (haystack[p1] == needle[p2]) {
                p1++;
                p2++;
                if (p2 == strlen(needle)) return p1 - strlen(needle);
            }
            // 不匹配的情况
            else {
                if (p2 == 0) p1++;
                else p2 = next[p2-1];
            }
        }
        return -1;
    }

