    int* createNext(char* needle) {
        // 创建返回数组
        int* next = (int*)malloc(sizeof(int) * strlen(needle));
        next[0] = 0;

        int left = 0, right = 1;
        while (right < strlen(needle)) {
            // 如果两个指针指向的内容相同，两个指针都后移
            if (needle[left] == needle[right]) {
                next[right] = left + 1;
                left++;
                right++;
            }
            else {
                // 如果两个指针指向的内容不同且j指向开头，i处参数记为0，i往后移
                if (left == 0) {
                    next[right] = 0;
                    right++;
                }
                // 如果两个指针指向的内容不同且j不指向开头，通过现有参数重新定位j
                else left = next[left-1];
            }
        }
        return next;
    }
    
