            int charIndex = 0;
            bool consistent = true;
            char element;
    
            while (consistent) {
                if (charIndex >= strs[0].size()) {
                    consistent = false;
                    break;
                }
                element = strs[0][charIndex];
    
                for (int strIndex = 1; strIndex < strs.size(); strIndex++) {
                    if (charIndex >= strs[strIndex].size() || strs[strIndex][charIndex] != element) {
