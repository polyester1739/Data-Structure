    public:
        string longestCommonPrefix(vector<string>& strs) {
            // 如果字符串数组里面没有元素，返回空串
            if (strs == nullptr || strs.empty()) return "";
    
            // 如果所有在同一索引处的字符一致，记录该字符并后移索引
            string ret = "";
            int charIndex = 0;
            bool consistent = true;
            char element;
    
            while (consistent) {
                if (charIndex >= strs[0].size()) {
                    consistent = false;
                    break;
                }
                element = strs[0][charIndex];
    
                for (int strIndex = 1; strIndex < strs.size(); strIndex++) {
                    if (charIndex >= strs[strIndex].size() || strs[strIndex][charIndex] != element) {
                        consistent = false;
                        break;
                    }
                }
    
                if (consistent) {
                    ret += element;
                    charIndex++;
                }
            }
    
            return ret;
        }
    };

