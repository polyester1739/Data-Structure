Solution:
  C:
    int minSubArrayLen(int target, int* nums, int numsSize) {
        // 设置左右指针
        int left = 0, right = 0;
        int sum = 0;
        int length = INT_MAX;
    
        while (right < numsSize) {
            sum += nums[right++];
    
            // 如果总和大于等于target，记录窗口长度，缩小窗口
            while (sum >= target) {
                if (right - left < length) length = right - left;
                sum -= nums[left++];
            }
        }
    
        if (length == INT_MAX) return 0;
        else return length;
    }

