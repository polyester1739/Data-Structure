                ret[i].resize(i+1);
                ret[i][0] = 1;
                ret[i][i] = 1;
    
                // 每一行j索引处的元素都相当于上一行j索引与j-1索引处元素之和
                for (int j = 1; j < i; j++) ret[i][j] = ret[i-1][j-1] + ret[i-1][j];
