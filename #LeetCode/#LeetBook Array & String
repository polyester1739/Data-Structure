5. 零矩阵

编写一种算法，若M × N矩阵中某个元素为0，则将其所在的行与列清零。


示例 1：
  输入：
  [
    [1,1,1],
    [1,0,1],
    [1,1,1]
  ]
  输出：
  [
    [1,0,1],
    [0,0,0],
    [1,0,1]
  ]

Solution:
  C:
    void setZeroes(int** matrix, int matrixSize, int* matrixColSize) {
        // 创建参数表用于记录需要置为0的行和列
        bool* row = (bool*)calloc(matrixSize, sizeof(bool));
        bool* col = (bool*)calloc(matrixColSize[0], sizeof(bool));
    
        // 遍历矩阵，找出所有值为0的元素
        for (int i = 0; i < matrixSize; i++) {
            for (int j = 0; j < matrixColSize[0]; j++) {
                if (matrix[i][j] == 0) {
                    row[i] = 1;
                    col[j] = 1;
                }
            }
        }
    
        // 遍历参数表将对应的行和列置为0
        for (int i = 0; i < matrixSize; i++) {
            if (row[i] != 0) {
                for (int j = 0; j < matrixColSize[0]; j++) {
                    matrix[i][j] = 0;
                }
            }
        }
    
        for (int i = 0; i < matrixColSize[0]; i++) {
            if (col[i] != 0) {
                for (int j = 0; j < matrixSize; j++) {
                    matrix[j][i] = 0;
                }
            }
        }
    
        free(row);
        free(col);
    }

