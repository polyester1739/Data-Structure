3. 合并区间    (56)

以数组 intervals 表示若干个区间的集合，其中单个区间为 intervals[i] = [start_i, end_i] 。请你合并所有重叠的区间，并返回 一个不重叠的区间数组，该数组需恰好覆盖输入中的所有区间 。


示例 1：
  输入：intervals = [[1,3],[2,6],[8,10],[15,18]]
  输出：[[1,6],[8,10],[15,18]]
  解释：区间 [1,3] 和 [2,6] 重叠, 将它们合并为 [1,6].

示例 2：
  输入：intervals = [[1,4],[4,5]]
  输出：[[1,5]]
  解释：区间 [1,4] 和 [4,5] 可被视为重叠区间。

示例 3：
  输入：intervals = [[4,7],[1,4]]
  输出：[[1,7]]
  解释：区间 [1,4] 和 [4,7] 可被视为重叠区间。
 
提示：
  1 <= intervals.length <= 104
  intervals[i].length == 2
  0 <= start_i <= end_i <= 104

Solution:
  C:
    /**
     * Return an array of arrays of size *returnSize.
     * The sizes of the arrays are returned as *returnColumnSizes array.
     * Note: Both returned array and *columnSizes array must be malloced, assume caller calls free().
     */
    int cmp(const void* a, const void* b) {
        return (*(int**)a)[0] - (*(int**)b)[0];
    }
    
    void merge2Intervals(int* interval1, int* interval2) {
        // 实现对于给定的两个区间的合并
        interval1[0] = (interval1[0] > interval2[0]) ? interval2[0] : interval1[0];
        interval1[1] = (interval1[1] > interval2[1]) ? interval1[1] : interval2[1];
    }
    
    int** merge(int** intervals, int intervalsSize, int* intervalsColSize, int* returnSize, int** returnColumnSizes) {
        // 先按照区间的左端点进行排序
        qsort(intervals, intervalsSize, sizeof(intervals[0]), cmp);
    
        // 排序完成后，只需要考虑后一个区间的左端点是否落在前一个区间内部
        *returnSize = intervalsSize;
        int read = 0, write = 0;
        for (read; read < intervalsSize; read++) {
            if (write == 0 || intervals[write-1][1] < intervals[read][0]) {
                intervals[write] = intervals[read];
                write++;
            }
            else {
                merge2Intervals(intervals[write-1], intervals[read]);
                *returnSize = *returnSize - 1;
            }
        }
    
        // 设置返回的每一个区间的大小为2
        *returnColumnSizes = (int*)malloc(sizeof(int) * (*returnSize));
        for (int i = 0; i < *returnSize; i++) (*returnColumnSizes)[i] = 2;
    
        return intervals;
    }

  C++:
    class Solution {
    public:
        static int cmp(const void* a, const void* b) {
            return (*(int**)a)[0] - (*(int**)b)[0];
        }
    
        void merge2Intervals(vector<int>& interval1, vector<int>& interval2) {
            // 实现对于给定的两个区间的合并
            interval1[0] = (interval1[0] > interval2[0]) ? interval2[0] : interval1[0];
            interval1[1] = (interval1[1] > interval2[1]) ? interval1[1] : interval2[1];
        }
    
        vector<vector<int>> merge(vector<vector<int>>& intervals) {
            // 先按照区间的左端点进行排序
            std::qsort(intervals.data(), intervals.size(), sizeof(intervals[0]), cmp);
    
            // 排序完成后，只需要考虑后一个区间的左端点是否落在前一个区间内部
            int read = 0, write = 0;
            int removed = 0;
            for (read; read < intervals.size(); read++) {
                if (write == 0 || intervals[write-1][1] < intervals[read][0]) {
                    intervals[write] = intervals[read];
                    write++;
                }
                else {
                    merge2Intervals(intervals[write-1], intervals[read]);
                    removed++;
                }
            }
    
            for (int i = 0; i < removed; i++) intervals.pop_back();
            intervals.shrink_to_fit();
    
            return intervals;
        }
    };


4. 旋转矩阵

给你一幅由 N × N 矩阵表示的图像，其中每个像素的大小为 4 字节。请你设计一种算法，将图像旋转 90 度。
不占用额外内存空间能否做到？


示例 1：
  给定 matrix = 
  [
    [1,2,3],
    [4,5,6],
    [7,8,9]
  ],

  原地旋转输入矩阵，使其变为:
  [
    [7,4,1],
    [8,5,2],
    [9,6,3]
  ]

Solution:
  C:
    void rotate(int** matrix, int matrixSize, int* matrixColSize) {
        int temp;
        // 转置矩阵
        for (int i = 0; i < matrixSize; i++) {
            for (int j = i + 1; j < matrixSize; j++) {
                temp = matrix[i][j];
                matrix[i][j] = matrix[j][i];
                matrix[j][i] = temp;
            }
        }
    
        // 交换左侧列与右侧列的数值
        for (int i = 0; i < matrixSize; i++) {
            int left = 0, right = matrixSize - 1;
            while (left < right) {
                temp = matrix[i][left];
                matrix[i][left] = matrix[i][right];
                matrix[i][right] = temp;
                left++;
                right--;
            }
        }
    }

