    bool isPalindrome(char* s) {
        // 字符串处理
        char* adapted = (char*)malloc(sizeof(char) * (strlen(s) + 1));
        int p = 0;
        for (int i = 0; i < strlen(s); i++) {
            if (s[i] >= 'a' && s[i] <= 'z') adapted[p++] = s[i];
            else if (s[i] >= '0' && s[i] <= '9') adapted[p++] = s[i];
            else if (s[i] >= 'A' && s[i] <= 'Z') adapted[p++] = s[i] + 32;
            else continue;
        }
        adapted[p] = '\0';
    
        // 设置左右指针
        int left = 0, right = strlen(adapted) - 1;
        while (left < right) {
            if (adapted[left] != adapted[right]) return false;
            left++;
            right--;
        }
        free(adapted);
        return true;
    }

