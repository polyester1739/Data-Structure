  -10^4 <= nums[i] <= 10^4
  nums 已按升序排列

Solution:
  C:
    int removeDuplicates(int* nums, int numsSize) {
        // 设置快慢指针，快指针用于读取，慢指针用于写入
        int fast = 0, slow = 0;
        int mem;
        int length = 0;
    
        while (fast < numsSize) {
            // 如果有两个连续相同的，写入两个
            if (fast < numsSize-1 && nums[fast] == nums[fast+1]) {
                for (int i = 0; i < 2; i++) {
                    nums[slow++] = nums[fast];
                    length++;
                }
            }
            else {
                nums[slow++] = nums[fast];
                length++;
            }
    
            mem = nums[fast];
